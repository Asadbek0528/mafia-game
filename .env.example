# Скопируйте в .env.local и поменяйте, если backend скажет другие адреса.
# После изменения перезапустите npm run dev.

# Адрес backend (HTTP API). Для backend на своём компьютере: http://localhost:8000
BACKEND_URL=http://54.206.85.23

# WebSocket: auto = свой сервер на порту 3001 (npm run dev запускает его сам).
# Когда backend сделает свой WebSocket — впишите ws://адрес. Пусто = выключен.
NEXT_PUBLIC_WS_URL=auto

# Пути WebSocket. {id} заменяется на номер комнаты / игры.
NEXT_PUBLIC_WS_ROOM_PATH=/ws/room/{id}
NEXT_PUBLIC_WS_GAME_PATH=/ws/game/{id}
